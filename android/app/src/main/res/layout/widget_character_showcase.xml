<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_character_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_character_background"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_character_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_character_showcase_description"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_character_stand" />
</FrameLayout>
