<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for OAuth callback (Google sign-in via system browser) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.fitgotchi.app" />
            </intent-filter>

            <!-- Long-press app icon shortcuts -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Ask Balance: home-screen widget command popup -->
        <activity
            android:name=".AskBalanceActivity"
            android:theme="@style/ShortcutOverlayTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter>
                <action android:name="com.fitgotchi.app.ACTION_ASK_BALANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Meal: lightweight dialog overlay for the long-press app shortcut -->
        <activity
            android:name=".QuickMealActivity"
            android:theme="@style/QuickMealTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.fitgotchi.app.ACTION_QUICK_MEAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Coach Schedule picker: bottom-sheet dialog launched from the
             "Later" action on a coach_draft_ready notification. exported=false
             because the only valid launcher is CoachDraftMessagingService's
             PendingIntent inside this app. -->
        <activity
            android:name=".CoachScheduleActivity"
            android:theme="@style/QuickMealTheme"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:windowSoftInputMode="adjustPan|stateHidden">
            <intent-filter>
                <action android:name="com.fitgotchi.app.ACTION_SCHEDULE_COACH_REPLY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Health Connect permissions activity -->
        <activity
            android:name="androidx.health.connect.client.permission.HealthPermissionsRequestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect privacy policy (required by Google) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            Custom FirebaseMessagingService for coach DM drafts with inline reply.
            Extends Capacitor's MessagingService (see CoachDraftMessagingService.java)
            so non-coach-draft pushes fall through to super.onMessageReceived and
            get relayed to JS exactly as before. Priority=1 on the intent-filter
            is a hint but not authoritative — FCM picks services via queryIntentServices
            which returns by install order — so we ALSO strip Capacitor's default
            service from the merged manifest below.
        -->
        <service
            android:name=".CoachDraftMessagingService"
            android:exported="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            Strip the Capacitor plugin's default FirebaseMessagingService from
            the merged manifest. Required because Android dispatches the
            com.google.firebase.MESSAGING_EVENT action to whichever matching
            service queryIntentServices returns first, and the priority=1 we
            set above is not always honoured for service intent filters.
            tools:node="remove" must match on android:name. Declaring the
            intent-filter here too (even though node=remove ignores children)
            makes the merger match unambiguously across AGP versions.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Receives the inline reply text from the coach-draft notification action. -->
        <receiver
            android:name=".CoachReplyReceiver"
            android:exported="false" />

        <!-- Ask Balance search-bar widget for Android home screens. -->
        <receiver
            android:name=".AskBalanceWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ask_balance_info" />
        </receiver>

        <!-- Calories & Macros widget for Android home screens. -->
        <receiver
            android:name=".CalorieTrackerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calorie_tracker_info" />
        </receiver>

        <!-- Character showcase widget for Android home screens. -->
        <receiver
            android:name=".CharacterShowcaseWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_character_showcase_info" />
        </receiver>

        <!-- Daily Quiz widget for Android home screens. -->
        <receiver
            android:name=".DailyQuizWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_quiz_info" />
        </receiver>

        <!--
            Coach Inbox home-screen widget. Augments the lock-screen
            notifications with a persistent at-a-glance surface for batch
            triage. List rows are emitted by CoachInboxRemoteViewsService;
            refresh is event-driven via CoachInboxWidgetProvider.ACTION_REFRESH
            broadcasts fired from the messaging service / reply worker.

            exported=true is required by Android — the launcher process
            (com.android.launcher / OEM equivalents) needs to bind the
            APPWIDGET_UPDATE intent. The provider only listens for its own
            actions plus the system update; no sensitive surface area.
        -->
        <receiver
            android:name=".CoachInboxWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fitgotchi.app.ACTION_COACH_INBOX_REFRESH" />
                <action android:name="com.fitgotchi.app.ACTION_COACH_INBOX_REFRESH_TAP" />
                <action android:name="com.fitgotchi.app.ACTION_COACH_INBOX_COUNTS_READY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_coach_inbox_info" />
        </receiver>

        <!--
            RemoteViewsService backing the widget's ListView. The
            BIND_REMOTEVIEWS permission is required by the framework — the
            launcher refuses to bind the adapter without it, and the list
            silently shows the empty view.
        -->
        <service
            android:name=".CoachInboxRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Android live wallpaper that renders the current Balance character natively. -->
        <service
            android:name=".FitGotchiLiveWallpaperService"
            android:label="@string/live_wallpaper_character_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper_character" />
        </service>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera access for barcode scanning & food recognition -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Microphone access for voice meal logging -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />


    <!-- Location access for weather tracking -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Push Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Exact alarm scheduling for reliable meal reminder local notifications (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Re-schedule local notifications after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Strip permissions injected by @capgo/capacitor-health that we don't use -->
    <uses-permission android:name="android.permission.health.READ_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />

    <!-- Health Connect -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />

</manifest>
