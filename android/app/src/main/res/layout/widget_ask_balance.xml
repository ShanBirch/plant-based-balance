<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ask_balance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_ask_balance_background"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_ask_balance_search"
        android:tint="#4ADE80"
        android:contentDescription="@string/widget_ask_balance_description" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="Ask Balance..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="50dp"
        android:gravity="center"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:background="@drawable/widget_ask_balance_go_background"
        android:text="Go"
        android:textColor="#DCFCE7"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />
</LinearLayout>
