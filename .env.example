# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Stripe Configuration (existing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Gemini API (existing)
GEMINI_API_KEY=your-gemini-api-key

# ElevenLabs voice-message test path. Set real values in Netlify only.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_SHANNON_PROFESSIONAL_VOICE_ID=qndkzv7PLOlM7dM2zfZQ
# Optional:
# ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_16000

# Public media storage used for generated IG voice-note audio.
B2_KEY_ID=your-backblaze-key-id
B2_APPLICATION_KEY=your-backblaze-application-key
B2_BUCKET_ID=your-backblaze-bucket-id
B2_BUCKET_NAME=your-public-backblaze-bucket-name

# OpenAI fallback for coach/lead AI when Gemini or Vertex is unavailable.
# Set this in Netlify, never commit a real key.
OPENAI_API_KEY=your-openai-api-key
# Optional emergency switch: use OpenAI first and avoid Google AI calls.
# AI_PROVIDER=openai
# OPENAI_MODEL_CHAIN_COACH_FALLBACK=gpt-5.4-mini

# Meta CAPI (existing)
META_CAPI_ACCESS_TOKEN=your-meta-capi-token

# Fitbit API Integration
# Register your app at: https://dev.fitbit.com/apps/new
# Set OAuth 2.0 Application Type: "Server"
# Set Callback URL: https://your-site.com/api/fitbit/callback
FITBIT_CLIENT_ID=your-fitbit-client-id
FITBIT_CLIENT_SECRET=your-fitbit-client-secret

# WHOOP API Integration
# Register your app at: https://developer-dashboard.whoop.com/
# Set Redirect URI: https://your-site.com/api/whoop/callback
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret

# Oura Ring API Integration
# Register your app at: https://cloud.ouraring.com (API Applications)
# Set Redirect URI: https://your-site.com/api/oura/callback
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret

# Strava API Integration
# Register your app at: https://www.strava.com/settings/api
# Set Authorization Callback Domain: your-site.com
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# ManyChat (Instagram coach pipeline)
# Page token: manychat.com -> Settings -> API
# Webhook URL to configure on the ManyChat External Request action:
#   https://your-site.com/.netlify/functions/manychat-inbound
MANYCHAT_API_TOKEN=your-manychat-page-token
# Optional shared secret — if set, ManyChat must send `x-manychat-secret`
# header with the matching value. Leave unset while wiring up.
MANYCHAT_WEBHOOK_SECRET=
# Optional overrides — defaults are sane for IG via ManyChat
# MANYCHAT_SEND_URL=https://api.manychat.com/fb/sending/sendContent
# MANYCHAT_MESSAGE_TAG=HUMAN_AGENT
