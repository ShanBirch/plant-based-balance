<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_quiz_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_daily_quiz_background"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_daily_quiz_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Daily Quiz"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_daily_quiz_progress"
            android:layout_width="46dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_daily_quiz_badge_background"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="1/5"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_daily_quiz_question"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="4"
        android:text="Health IQ today"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_daily_quiz_option_1"
        style="@style/WidgetDailyQuizOption"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/widget_daily_quiz_option_2"
        style="@style/WidgetDailyQuizOption"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/widget_daily_quiz_option_3"
        style="@style/WidgetDailyQuizOption"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/widget_daily_quiz_option_4"
        style="@style/WidgetDailyQuizOption"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/widget_daily_quiz_restart"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
